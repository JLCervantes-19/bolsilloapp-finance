{
  "name": "bolsillo-frontend",
  "version": "1.0.0",
  "description": "Bolsillo — SPA Vanilla JS + Tailwind v4 (Liquid Glass) + api/ serverless (envuelve ../backend/src/app.js) para Vercel.",
  "type": "module",
  "scripts": {
    "dev:css": "tailwindcss -i ./public/assets/css/main.css -o ./public/assets/css/build.css --watch",
    "build:css": "tailwindcss -i ./public/assets/css/main.css -o ./public/assets/css/build.css --minify",
    "build": "npm run build:css",
    "serve": "npx serve public -l 5173"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.4",
    "tailwindcss": "^4.1.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "ws": "^8.21.1",
    "zod": "^3.23.8"
  }
}
